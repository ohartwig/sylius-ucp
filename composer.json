{
    "name": "koh/sylius-ucp",
    "description": "Universal Commerce Protocol (UCP) adapter for Sylius (Google/Shopify agentic-commerce standard).",
    "type": "sylius-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/sylius-ucp/issues",
        "source": "https://github.com/ohartwig/sylius-ucp",
        "security": "https://github.com/ohartwig/sylius-ucp/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=8.5.11",
        "koh/sylius-agent-contracts": "^1.1",
        "doctrine/persistence": "^3.3 || ^4.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/routing": "^6.4 || ^7.4"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusUcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusUcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
