{
    "name": "koh/sylius-ucp",
    "description": "Universal Commerce Protocol (UCP) adapter for Sylius (Google/Shopify agentic-commerce standard).",
    "type": "sylius-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "koh/sylius-agent-contracts": "^1.1",
        "sylius/sylius": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "*",
        "phpunit/phpunit": "*",
        "phpstan/extension-installer": "*"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusUcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusUcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
